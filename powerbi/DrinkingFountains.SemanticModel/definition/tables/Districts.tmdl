table Districts
	lineageTag: 4b9fc0ff-41a2-ee89-63ec-c9ac50a67666

	/// Share of the districts’ street length within a 5-minute walk of a fountain (%)
	measure 'District streets in reach' = DIVIDE ( SUM ( Districts[reached_km] ), SUM ( Districts[street_km] ) ) * 100
		formatString: 0.0
		lineageTag: 5ea4a988-6b11-7bf3-ea1d-a2086bf7f268

	column district
