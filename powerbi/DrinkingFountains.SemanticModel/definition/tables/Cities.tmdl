table Cities
	lineageTag: f517e4b0-a3b8-9a01-8f69-ebcf56b974de

	/// Share of street length within a 5-minute walk of a fountain, for the cities in view
	measure 'Streets within 5 min' = DIVIDE ( SUM ( Cities[reached_km] ), SUM ( Cities[street_km] ) )
		formatString: 0.0%
		lineageTag: cd07c1f0-4fc4-f5ba-bb96-94d8d3029ca2

	/// Share of street length within a 2-minute walk, one city at a time
	measure 'Streets within 2 min' = AVERAGE ( Cities[streets_2min_pct] ) / 100
		formatString: 0.0%
		lineageTag: c652c394-5150-e2fe-b0d8-56ba9e9dbde4

	/// Fountains inside the study areas in view
	measure 'Fountains in study areas' = SUM ( Cities[fountains] )
		formatString: #,0
		lineageTag: c888e6df-df82-7243-e6ad-4028ff7d2cd0

