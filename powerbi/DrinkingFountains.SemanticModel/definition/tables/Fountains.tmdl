				    Typed = Table.TransformColumnTypes(Kept, {{"fountain", type text}, {"city", type text}, {"kind", type text}, {"source", type text}, {"where", type text}, {"in_study_area", type text}, {"lat", type number}, {"lng", type number}}, "en-US")
